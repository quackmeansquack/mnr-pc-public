<Application x:Class="MNRLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF UI (Fluent) styles for the standard controls; Core\Themes.cs applies the chosen colours -->
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- the launcher's own colours: Pit lane until Themes.Apply replaces them (pages use them as DynamicResource) -->
            <Color x:Key="BgColor">#FF1F1F21</Color>
            <SolidColorBrush x:Key="Bg" Color="#FF1F1F21"/>
            <SolidColorBrush x:Key="Panel" Color="#FF19191B"/>
            <SolidColorBrush x:Key="PanelHi" Color="#FF2A2A2D"/>
            <SolidColorBrush x:Key="Line" Color="#FF3A3A3E"/>
            <SolidColorBrush x:Key="Text" Color="#FFF3F1EC"/>
            <SolidColorBrush x:Key="SubText" Color="#FFA9A6A0"/>
            <SolidColorBrush x:Key="Accent" Color="#FFF59A00"/>
            <SolidColorBrush x:Key="AccentHi" Color="#FFFFB233"/>
            <SolidColorBrush x:Key="OnAccent" Color="#FF2B1800"/>
            <SolidColorBrush x:Key="Accent2" Color="#FFFFC94A"/>
            <SolidColorBrush x:Key="Good" Color="#FF4CC38A"/>
            <SolidColorBrush x:Key="Warn" Color="#FFF0B429"/>

            <!-- the game's lettering (Fonts\: ModNation Title is the logo's, ModNation Body its menus') for headings -->
            <FontFamily x:Key="TitleFont">pack://application:,,,/Fonts/#ModNation Title</FontFamily>
            <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#ModNation Body</FontFamily>
            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="H2" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Margin" Value="0,18,0,6"/>
            </Style>
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <!-- a section of a page: a rounded card, as WPF UI draws its settings rows -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Margin" Value="0,4"/>
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
                <Setter Property="Margin" Value="0,0,16,0"/>
            </Style>

            <!-- the sidebar: icon (Tag, a WPF UI symbol), name, and the accent pill on the page shown -->
            <Style x:Key="Nav" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="8,1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,9">
                                <Grid>
                                    <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0" Background="Transparent"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" Margin="0,0,12,0"
                                                       Foreground="{TemplateBinding Foreground}"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                    <Setter TargetName="bar" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- list rows as cards (the pages' lists of mods, creations, profiles, accounts) -->
            <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="b" Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="12,10">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SubText}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
