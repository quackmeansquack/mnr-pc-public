<UserControl x:Class="MNRLauncher.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Mods" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Text="Mods replace game files and apply data patches. Tick to enable; enabled mods load top to bottom, and when two replace the same file the higher one wins. Share a mod as a .mnrmod file."/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,14">
                <Button Content="Import .mnrmod…" Click="Import_Click"/>
                <Button Content="New mod…" Click="New_Click"/>
                <Button Content="Open mods folder" Click="OpenFolder_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Width="150" Margin="16,0,0,0">
            <Button Content="Move up" Click="Up_Click" Margin="0,0,0,6"/>
            <Button Content="Move down" Click="Down_Click" Margin="0,0,0,6"/>
            <Button Content="Export…" Click="Export_Click" Margin="0,0,0,6"/>
            <Button Content="Show files" Click="Show_Click" Margin="0,0,0,6"/>
            <Button Content="Delete" Click="Delete_Click" Margin="0,0,0,6"/>
        </StackPanel>
        <Grid>
            <ListBox x:Name="List">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled, Mode=OneWay}" Checked="Toggle" Unchecked="Toggle" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Image DockPanel.Dock="Left" Source="{Binding Preview}" Width="64" Height="40" Stretch="UniformToFill" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Sub}"/>
                                <TextBlock Text="{Binding Info.Description}" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Style="{StaticResource Sub}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="No mods yet.&#x0a;Import a .mnrmod file, or make one with “New mod…”."/>
        </Grid>
    </DockPanel>
</UserControl>
