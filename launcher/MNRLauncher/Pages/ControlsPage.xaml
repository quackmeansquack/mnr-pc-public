<UserControl x:Class="MNRLauncher.Pages.ControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Controls" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Text="Wheels, pedals, sticks and button boxes. Click Bind next to a control, then move or press what you want for it: for the steering turn the wheel to the RIGHT; for a pedal press it all the way down. Several devices can be used together (e.g. a wheel with separate pedals). Xbox controllers work without setup."/>
        </StackPanel>
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                <TextBlock Text="CONNECTED CONTROLLERS" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                <Button Content="Refresh list" HorizontalAlignment="Left" Click="Rescan_Click" Margin="0,0,0,8"/>
                <ListBox x:Name="Devices" SelectionChanged="Devices_SelectionChanged" MaxHeight="190">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Sub}">
                                    <Run Text="{Binding Key, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Axes, Mode=OneWay}"/><Run Text=" axes, "/><Run Text="{Binding Buttons, Mode=OneWay}"/><Run Text=" buttons"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="Live" Margin="0,12,0,0"/>
                <StackPanel>
                    <TextBlock Text="WHEEL" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Wheel rotation (degrees)" VerticalAlignment="Center"/>
                        <TextBox x:Name="WheelDeg" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Text="Full lock in game at (°)" VerticalAlignment="Center"/>
                        <TextBox x:Name="SteerLock" Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,2"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Sub}" Text="E.g. 900 and 270: turning 135° to a side gives full steering. Lower = more sensitive."/>
                    <DockPanel Margin="0,6,0,2"><TextBlock x:Name="BoostText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/><TextBlock Text="Steering boost" Width="110"/><Slider x:Name="Boost" Minimum="0" Maximum="50" ValueChanged="Ffb_ValueChanged"/></DockPanel>
                    <TextBlock Style="{StaticResource Sub}" Text="Small turns already steer (the game ignores small stick movements). Raise it if the kart doesn't react near the centre."/>
                    <CheckBox x:Name="Ffb" Content="Force feedback" Margin="0,8,0,2"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Replaces the wheel's stiff default centring with a smooth spring and damper."/>
                    <DockPanel Margin="0,2"><TextBlock x:Name="SpringText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/><TextBlock Text="Centring spring" Width="110"/><Slider x:Name="Spring" Minimum="0" Maximum="100" ValueChanged="Ffb_ValueChanged"/></DockPanel>
                    <DockPanel Margin="0,2"><TextBlock x:Name="DamperText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/><TextBlock Text="Damper" Width="110"/><Slider x:Name="Damper" Minimum="0" Maximum="100" ValueChanged="Ffb_ValueChanged"/></DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Apply" Style="{StaticResource Primary}" Click="ApplyWheel_Click"/>
                        <TextBlock x:Name="WheelSaved" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Clear all" Click="ClearAll_Click" Margin="0"/>
                    <TextBlock Text="BINDINGS" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <Border DockPanel.Dock="Top" x:Name="Listening" Background="{DynamicResource Accent}" CornerRadius="3" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="ListeningText" FontWeight="SemiBold"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Rows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Panel}" CornerRadius="3" Padding="10,7" Margin="0,0,0,5">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Clear" Tag="{Binding}" Click="Clear_Click" Margin="6,0,0,0" Padding="10,3"/>
                                        <Button DockPanel.Dock="Right" Content="Bind" Tag="{Binding}" Click="Bind_Click" Margin="6,0,0,0" Padding="12,3"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Def.Name}" Width="230" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Sub}" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
