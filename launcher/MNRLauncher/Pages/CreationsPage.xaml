<UserControl x:Class="MNRLauncher.Pages.CreationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="My creations" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Text="Your characters, karts and tracks as the game saves them. Export one as a .mnrcreation file to share it; importing one puts it where the game finds it."/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,14">
                <Button Content="Import .mnrcreation…" Click="Import_Click"/>
                <Button Content="Open creations folder" Click="OpenFolder_Click"/>
                <Button Content="Check my creations" Click="Check_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Width="150" Margin="16,0,0,0">
            <Button Content="Export…" Click="Export_Click" Margin="0,0,0,6"/>
            <Button Content="Show files" Click="Show_Click" Margin="0,0,0,6"/>
        </StackPanel>
        <Grid>
            <ListBox x:Name="List">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="{Binding ThumbnailImage}" Width="72" Height="72" Stretch="Uniform" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Sub}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Style="{StaticResource Sub}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="Nothing here yet.&#x0a;Make something in the Creation Station, or import a .mnrcreation file."/>
        </Grid>
    </DockPanel>
</UserControl>
