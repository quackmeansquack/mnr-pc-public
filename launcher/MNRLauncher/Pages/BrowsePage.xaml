<UserControl x:Class="MNRLauncher.Pages.BrowsePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- the soft backdrop characters and karts (transparent pictures) stand on -->
        <RadialGradientBrush x:Key="Stage" Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.75" RadiusY="0.7">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
    </UserControl.Resources>
    <DockPanel Margin="28,20,28,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Browse creations" Style="{StaticResource H1}"/>
            <TextBlock x:Name="Source" Style="{StaticResource Sub}"/>
            <Grid Margin="0,14,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="Query" PlaceholderText="Search by name or creator" Icon="{ui:SymbolIcon Search24}" KeyDown="Query_KeyDown"/>
                <ComboBox x:Name="TypeBox" Grid.Column="1" Width="140" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Everything"/>
                    <ComboBoxItem Content="Characters"/>
                    <ComboBoxItem Content="Karts"/>
                    <ComboBoxItem Content="Tracks"/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Grid.Column="2" Width="170" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Oldest"/>
                    <ComboBoxItem Content="Most downloaded"/>
                </ComboBox>
                <Button Grid.Column="3" Content="Search" Style="{StaticResource Primary}" Click="Search_Click" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="Prev" Content="‹ Previous" Click="Prev_Click"/>
                <Button x:Name="Next" Content="Next ›" Click="Next_Click" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="PageInfo" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- the chosen creation -->
        <Border DockPanel.Dock="Right" Width="300" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0" x:Name="DetailCard" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Detail">
                    <Border CornerRadius="8,8,0,0" Height="230" Background="{DynamicResource Panel}" ClipToBounds="True">
                        <Grid>
                            <Border Background="{StaticResource Stage}"/>
                            <Image x:Name="DetailImage" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,12,16,16">
                        <TextBlock x:Name="DetailName" FontFamily="{StaticResource BodyFont}" FontSize="22" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailSummary" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="DetailDesc" Style="{StaticResource Sub}" Margin="0,10,0,0" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="DetailTags" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="DownloadButton" Content="Download to game" Style="{StaticResource Primary}" Click="Download_Click"/>
                            <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="DetailStatus" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- the gallery -->
        <Grid>
            <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" SizeChanged="List_SizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Top"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Margin="0,0,10,10" Background="{DynamicResource PanelHi}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" CornerRadius="10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SubText}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border CornerRadius="9,9,0,0" Height="150" Background="{DynamicResource Panel}" ClipToBounds="True">
                                <Grid>
                                    <Border Background="{StaticResource Stage}"/>
                                    <Image Source="{Binding Thumb}" Stretch="{Binding Fit}" Margin="{Binding PictureMargin}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border Visibility="{Binding InstalledTag}" Background="{DynamicResource Accent}" CornerRadius="4" Padding="6,1"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                        <TextBlock Text="Installed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Text="{Binding C.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Line2}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding Line3}" Style="{StaticResource Sub}" Foreground="{DynamicResource Accent2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Message" Style="{StaticResource Sub}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
        </Grid>
    </DockPanel>
</UserControl>
